CONFIG_ZYBO_VERIFIED_BOOT=y
CONFIG_DEFAULT_DEVICE_TREE="zynq-zybo-z7"
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
# CONFIG_OF_BOARD is not set
CONFIG_OF_LIST="zynq-zybo-z7"
# CONFIG_SPL is not set
CONFIG_TEXT_BASE=0x04000000
CONFIG_FIT=y
CONFIG_FIT_SIGNATURE=y
CONFIG_FIT_FULL_CHECK=y
CONFIG_FIT_VERBOSE=y
CONFIG_FIT_SIGNATURE_MAX_SIZE=0x04000000
CONFIG_RSA=y
CONFIG_RSA_VERIFY=y
CONFIG_SHA256=y
CONFIG_TOOLS_LIBCRYPTO=y
CONFIG_TOOLS_FIT_SIGNATURE=y
# CONFIG_LEGACY_IMAGE_FORMAT is not set
# CONFIG_DISTRO_DEFAULTS is not set
# CONFIG_USE_PREBOOT is not set
# CONFIG_USE_BOOTCOMMAND is not set
# CONFIG_AUTOBOOT is not set
# CONFIG_BOOTSTD is not set
# CONFIG_ENV_IS_IN_FAT is not set
# CONFIG_ENV_IS_IN_EXT4 is not set
# CONFIG_ENV_IS_IN_NAND is not set
# CONFIG_ENV_IS_IN_SPI_FLASH is not set
# CONFIG_ENV_IS_IN_FLASH is not set
# CONFIG_ENV_IS_IN_MMC is not set
# CONFIG_ENV_IS_IN_UBI is not set
CONFIG_ENV_IS_NOWHERE=y
# CONFIG_NETCONSOLE is not set
# CONFIG_CMD_SOURCE is not set
# CONFIG_CMD_BOOTZ is not set
# CONFIG_CMD_BOOTI is not set
# CONFIG_CMD_GO is not set
# CONFIG_CMD_BOOTEFI is not set
# CONFIG_EFI_LOADER is not set
# CONFIG_UPDATE_TFTP is not set
# CONFIG_CMD_DFU is not set
# CONFIG_CMD_THOR_DOWNLOAD is not set
# CONFIG_USB_GADGET is not set
CONFIG_CMD_BOOTM=y
CONFIG_BOOTM_LINUX=y
CONFIG_CMD_MMC=y
CONFIG_CMD_FAT=y
CONFIG_CMD_MEMTEST=y
CONFIG_SYS_ALT_MEMTEST=y
CONFIG_SYS_BOOTM_LEN=0x04000000
CONFIG_HUSH_PARSER=y
